# Copy to .env.local (`npm run setup` does it for you) and adjust if needed.
# Never commit real credentials: .env.local is git-ignored.

# Qdrant. Local Docker defaults; production values live in Vercel.
QDRANT_URL=http://localhost:6333
# Empty locally. Use a read-only key in Vercel (Preview and Production).
QDRANT_API_KEY=
QDRANT_COLLECTION=products
# Vercel only (optional): a random string of 16+ characters. Vercel Cron sends
# it to /api/keepalive, which then rejects other callers (ADR 0012).
CRON_SECRET=

# Catalog images (ADR 0005). Empty locally: the app serves data/images at /images.
# In Vercel, the public URL of the R2 bucket, with no trailing slash.
NEXT_PUBLIC_IMAGE_BASE_URL=

# Optional (ADR 0013): an OpenAI API key enables outfit descriptions on
# /outfit. Empty means the outfit search uses CLIP alone. Set it in Vercel as
# a Sensitive variable; never commit it.
OPENAI_API_KEY=
# Defaults to gpt-6-luna, OpenAI's cheapest vision model in Nov 2026.
OPENAI_MODEL=

# Only for `npm run index:images`, never in Vercel. An R2 API token with
# Object Read & Write on the images bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
