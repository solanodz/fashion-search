{
  "name": "fashion-search",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "dev:all": "docker compose up -d --wait && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:model": "vitest run --project model",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "index:prepare": "node scripts/indexing/prepare.ts",
    "index:embed": "node scripts/indexing/embed.ts",
    "index:upload": "node --env-file-if-exists=.env.local scripts/indexing/upload.ts",
    "index:images": "node --env-file-if-exists=.env.local scripts/indexing/images.ts",
    "index:eval": "node --env-file-if-exists=.env.local scripts/indexing/eval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@qdrant/js-client-rest": "^1.20.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "aws4fetch": "^1.0.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "hyparquet": "^1.33.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "^7.30.2"
    }
  }
}
